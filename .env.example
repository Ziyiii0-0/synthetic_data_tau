# Copy to .env and fill in the keys for the providers you use (loaded automatically).
# Model names follow LiteLLM: https://docs.litellm.ai/docs/providers

# Default model for every pipeline stage (see src/synthesis/common.py)
# SYNTH_MODEL=anthropic/claude-sonnet-4-5-20250929

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS Bedrock (e.g. SYNTH_MODEL=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# Local OpenAI-compatible server (vLLM): use --model hosted_vllm/<name>
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1
